# =====================================================================
# Family Circle - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# =====================================================================

# Server & Runtime
NODE_ENV=development
PORT=4000
BIND_ADDRESS=0.0.0.0
APP_NAME="Family Circle"
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL 8)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://family_user:family_password@localhost:3306/family_circle"

# Database Configuration for Docker Compose
MYSQL_ROOT_PASSWORD=root_super_secure_password
MYSQL_DATABASE=family_circle
MYSQL_USER=family_user
MYSQL_PASSWORD=family_password
MYSQL_PORT=3306

# Authentication & Security
# Generate secure 256-bit random keys: openssl rand -base64 32
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_SECURE_RANDOM_ACCESS_SECRET_32_BYTES_MIN"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_SECURE_RANDOM_REFRESH_SECRET_32_BYTES_MIN"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
PASSWORD_RESET_TOKEN_EXPIRATION="1h"

# Argon2id Tuning (defaults are secure for server nodes)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Location & Privacy Defaults
DEFAULT_LOCATION_RETENTION_DAYS=7
STALE_LOCATION_THRESHOLD_MINUTES=10
MIN_LOCATION_ACCURACY_METERS=100.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Web Push (VAPID) - Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="CHANGE_ME_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="CHANGE_ME_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:support@familycircle.local"

# Firebase Cloud Messaging (Android Push)
# Path to downloaded Firebase service account JSON file, e.g. ./firebase-admin-key.json
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Optional Redis Cache / Queue (leave blank to run in-memory)
REDIS_URL=""

# Logging
LOG_LEVEL="info"

